# Le mode live passe par un WebSocket (ADR 0021) : nginx relaie la demande de changement de protocole.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    # Compression (ADR 0050) : le JavaScript et le CSS de la PWA pèsent trois à quatre fois moins une fois compressés,
    # ce qui compte sur un téléphone en 4G. Le niveau 6 est celui que mesure le budget de la CI (npm run size).
    gzip on;
    gzip_vary on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types text/css application/javascript text/javascript application/json application/manifest+json image/svg+xml;

    # Même origine pour le front et l'API : pas de CORS à configurer.
    location /api/ {
        include /etc/nginx/snippets/security-headers.conf;
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # Une salle d'attente peut rester silencieuse plusieurs minutes.
        proxy_read_timeout 1h;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Le service worker et le manifeste ne doivent jamais être mis en cache longtemps.
    location ~* ^/(sw\.js|workbox-.*\.js|manifest\.webmanifest)$ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
    }

    # Fichiers versionnés par Vite (hash dans le nom) : cache long.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    # Application monopage : toute autre route renvoie index.html.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri $uri/ /index.html;
    }
}
