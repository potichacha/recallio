#!/bin/sh
# Les coordonnées de l'éditeur (ADR 0074), échappées avant que nginx ne les écrive dans index.html. L'image de nginx
# source ce fichier (*.envsh) avant de remplir le gabarit (20-envsubst-on-templates.sh) : ce qu'il exporte s'y lit.
#
# La valeur passe par deux lectures : celle de nginx (une chaîne entre apostrophes de sub_filter, où « $ » annonce une
# variable et « \ » échappe) puis celle du navigateur (un attribut HTML entre guillemets). Une référence de caractère
# HTML convient aux deux : nginx n'y voit que du texte, le navigateur rend le caractère. Un nom avec une apostrophe ou
# un guillemet ne casse donc ni la configuration ni la page, et ne peut rien y injecter.

escape_for_html_attribute() {
    # « & » d'abord : les références écrites ensuite en contiennent un. Un retour à la ligne finirait la directive.
    printf '%s' "$1" | tr -d '\r\n' | sed \
        -e 's/&/\&amp;/g' \
        -e 's/</\&lt;/g' \
        -e 's/>/\&gt;/g' \
        -e 's/"/\&quot;/g' \
        -e "s/'/\&#39;/g" \
        -e 's/\\/\&#92;/g' \
        -e 's/\$/\&#36;/g'
}

LEGAL_PUBLISHER_HTML=$(escape_for_html_attribute "${LEGAL_PUBLISHER:-}")
LEGAL_CONTACT_EMAIL_HTML=$(escape_for_html_attribute "${LEGAL_CONTACT_EMAIL:-}")
export LEGAL_PUBLISHER_HTML LEGAL_CONTACT_EMAIL_HTML
