# Le tunnel WireGuard, côté runner (ADR 0072) : ce serveur écoute, et n'accepte qu'un pair, le serveur de
# l'application. Le runner publie son port sur l'adresse de ce tunnel seulement, 10.13.13.2:8090.
#
# Un modèle, sans aucune clé : à copier en /etc/wireguard/wg0.conf (chmod 600), puis à remplir en remplaçant chaque
# marqueur <...> (docs/deploiement.md, section 11, « WireGuard »). Les clés se génèrent sur chaque serveur ; une clé
# privée ne quitte jamais le sien.

[Interface]
# L'adresse du serveur dans le tunnel : celle du port du runner (WIREGUARD_ADDRESS, dans le .env).
Address = 10.13.13.2/24
# Le seul port qu'ouvre le pare-feu, pour l'adresse IPv4 du serveur de l'application seulement.
ListenPort = 51820
# La clé privée de ce serveur : /etc/wireguard/private.key.
PrivateKey = <RUNNER_PRIVATE_KEY>

[Peer]
# Le serveur de l'application. Pas d'Endpoint : c'est lui qui appelle, et ce serveur lui répond à l'adresse d'où il
# appelle.
# Sa clé publique : /etc/wireguard/public.key, sur le serveur de l'application.
PublicKey = <APP_PUBLIC_KEY>
# La clé partagée par les deux serveurs (wg genpsk) : /etc/wireguard/preshared.key, la même des deux côtés.
PresharedKey = <PRESHARED_KEY>
# Les seuls paquets acceptés de ce pair : ceux qui viennent de son adresse dans le tunnel.
AllowedIPs = 10.13.13.1/32
