# La configuration de la sauvegarde (ADR 0073), lue par recallio-backup.service. À copier hors du dépôt, puis à remplir
# (docs/deploiement.md, section 12) :
#
#   sudo install -d -m 700 /etc/recallio-backup
#   sudo install -m 600 backup/backup.env.example /etc/recallio-backup/backup.env
#
# Un fichier d'environnement de systemd : une ligne CLÉ=valeur par variable, sans guillemets ni espaces autour du signe
# égal. Les identifiants du stockage n'y sont pas : ils sont dans /etc/recallio-backup/rclone.conf.

# La clé publique d'age pour laquelle chaque sauvegarde est chiffrée : la ligne « age1... » affichée par age-keygen, sur
# ton poste. Elle n'est pas secrète. La clé privée (AGE-SECRET-KEY-1...), elle, ne vient jamais sur le serveur.
BACKUP_AGE_RECIPIENT=

# La destination, pour rclone : <remote>:<bucket>/<dossier>. Le remote est celui de rclone.conf (recallio-backup) ; le
# bucket, celui que tu as créé ; le dossier reste « postgres ».
BACKUP_DESTINATION=recallio-backup:<BUCKET>/postgres

# Facultatif : l'adresse qu'un service de surveillance attend chaque jour (Healthchecks.io ou un autre), appelée après
# une sauvegarde réussie. Vide, rien n'est appelé. Elle vaut identifiant : ne la publie pas.
BACKUP_HEARTBEAT_URL=
