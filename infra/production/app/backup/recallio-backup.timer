# Chaque nuit, la sauvegarde des bases (recallio-backup.service, ADR 0073). À activer par :
#
#   sudo systemctl enable --now recallio-backup.timer
#   systemctl list-timers recallio-backup.timer

[Unit]
Description=Sauvegarde des bases de Recallio, chaque nuit
Documentation=https://github.com/potichacha/recallio/blob/main/docs/deploiement.md

[Timer]
# 02:15 UTC, l'heure creuse des utilisateurs européens (03:15 ou 04:15 à Paris), quel que soit le fuseau du serveur.
OnCalendar=*-*-* 02:15:00 UTC
# Jusqu'à 15 minutes plus tard, pour ne pas appeler le stockage à la seconde où tout le monde le fait.
RandomizedDelaySec=15min
# Une sauvegarde manquée parce que le serveur était éteint est lancée à son démarrage.
Persistent=true

[Install]
WantedBy=timers.target
