# La sauvegarde des bases du serveur de l'application (ADR 0073), lancée par recallio-backup.timer. À installer par :
#
#   sudo install -m 644 backup/recallio-backup.service backup/recallio-backup.timer /etc/systemd/system/
#   sudo systemctl daemon-reload
#
# À la main :  sudo systemctl start recallio-backup.service ; son journal :  journalctl -u recallio-backup.service

[Unit]
Description=Sauvegarde chiffrée des bases de Recallio, hors du serveur
Documentation=https://github.com/potichacha/recallio/blob/main/docs/deploiement.md
# Le script appelle pg_dump dans le conteneur postgres, puis envoie par le réseau.
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# root : le socket Docker, le .env du compose et les deux fichiers de /etc/recallio-backup, lisibles par lui seul.
User=root
# La clé publique d'age, la destination et le battement de cœur.
EnvironmentFile=/etc/recallio-backup/backup.env
# Les identifiants du stockage.
Environment=RCLONE_CONFIG=/etc/recallio-backup/rclone.conf
# Par bash, pour ne pas dépendre du bit d'exécution du fichier.
ExecStart=/usr/bin/bash /opt/recallio/infra/production/app/backup/backup.sh
# Le dossier de travail, /var/lib/recallio-backup (STATE_DIRECTORY) : il ne reçoit que des fichiers chiffrés, effacés à
# la fin.
StateDirectory=recallio-backup
StateDirectoryMode=0700
UMask=0077
# Une sauvegarde bloquée (le réseau, le stockage) est arrêtée, et compte comme un échec.
TimeoutStartSec=1h
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
