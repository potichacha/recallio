# La destination des sauvegardes, pour rclone (ADR 0073) : un stockage objet compatible S3, hors d'OVHcloud. Un modèle,
# sans aucun identifiant : à copier hors du dépôt, puis à remplir en remplaçant chaque marqueur <...>
# (docs/deploiement.md, section 12) :
#
#   sudo install -m 600 backup/rclone.conf.example /etc/recallio-backup/rclone.conf
#
# Les valeurs ci-dessous sont celles de Backblaze B2, par son API S3. Pour un autre fournisseur, seuls ce fichier et le
# nom du bucket changent : le script ne connaît que le nom du remote.

[recallio-backup]
type = s3
provider = Other
# La clé d'application du serveur : elle ne peut que lister et écrire dans le bucket des sauvegardes, ni lire, ni
# supprimer (listBuckets, listAllBucketNames, listFiles, writeFiles).
access_key_id = <B2_KEY_ID>
secret_access_key = <B2_APPLICATION_KEY>
# La région du bucket, affichée dans son « Endpoint » : s3.<région>.backblazeb2.com (par exemple eu-central-003).
region = <B2_REGION>
endpoint = https://s3.<B2_REGION>.backblazeb2.com
# Le bucket existe déjà, et la clé ne peut ni le créer ni le vérifier.
no_check_bucket = true
# Pas de requête HEAD après l'envoi : la clé ne peut pas lire. Le stockage vérifie l'empreinte MD5 à la réception, et le
# script retrouve chaque fichier dans la liste du bucket.
no_head = true
