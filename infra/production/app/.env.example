# Les variables du serveur de l'application (ADR 0071), lues par compose.yaml. À copier en .env, dans ce dossier, puis à
# remplir (docs/deploiement.md, « Configurer ») :
#
#   cp .env.example .env && chmod 600 .env
#
# Le .env n'est jamais versionné (.gitignore) : il porte tous les secrets du serveur. Sauvegardez-le à part, hors du
# serveur. Les valeurs vides ci-dessous sont des secrets à générer : Compose refuse de démarrer tant qu'il en manque un.
# Une valeur ne doit contenir ni espace, ni guillemet, ni $ : les commandes proposées n'en produisent pas.

# --- La version déployée ----------------------------------------------------------------------------------------------

# Le tag des images du backend et du front, celui d'un commit dont le job publish de la CI est entièrement vert sur main
# (ADR 0069) : sha- et les 12 premiers caractères du commit. Revenir en arrière, c'est remettre le précédent.
RECALLIO_TAG=sha-0123456789ab

# --- Le domaine -------------------------------------------------------------------------------------------------------

# Le domaine du site, sans https:// ni barre finale. Le compose en déduit tout le reste : l'origine publique
# (https://<domaine>), Keycloak (https://auth.<domaine>), l'expéditeur des e-mails (no-reply@<domaine>).
DOMAIN=recallio.example
# L'adresse à laquelle Let's Encrypt écrit en cas de problème de certificat.
ACME_EMAIL=admin@recallio.example

# --- Les pages légales (ADR 0074) -------------------------------------------------------------------------------------
# « Mentions légales » et « Politique de confidentialité ». Le dépôt est public : ces coordonnées n'y sont pas écrites,
# le front les reçoit à son démarrage. Les changer demande de recréer le front (docker compose up -d).

# L'adresse à laquelle on t'écrit : droits sur les données, signalement d'un contenu. Obligatoire : Compose refuse de
# démarrer sans elle. Une adresse dédiée, que tu lis vraiment (contact@<domaine>, par exemple).
LEGAL_CONTACT_EMAIL=
# Le nom de l'éditeur du site, publié dans les mentions légales. Facultatif. Vide : les pages disent que le site est
# édité par un particulier, à titre non professionnel, qui a communiqué son identité à l'hébergeur (loi n° 2004-575,
# article 1-1, II). Entre guillemets s'il contient un espace : LEGAL_PUBLISHER="Prénom Nom"
LEGAL_PUBLISHER=

# --- PostgreSQL : une instance, deux bases, trois rôles ---------------------------------------------------------------
# Lus à la première initialisation de la base seulement : les changer ensuite ne change pas les mots de passe de
# PostgreSQL (docs/deploiement.md, « Exploiter »). Chacun se génère par :  openssl rand -hex 32

# Le superutilisateur postgres, pour administrer l'instance (sauvegardes, migrations de version).
POSTGRES_PASSWORD=
# Le rôle recallio, propriétaire de la base recallio : le backend.
RECALLIO_DB_PASSWORD=
# Le rôle keycloak, propriétaire de la base keycloak.
KEYCLOAK_DB_PASSWORD=

# --- Keycloak ---------------------------------------------------------------------------------------------------------

# Le mot de passe du compte d'administration temporaire, temp-admin (royaume master), créé au tout premier démarrage
# seulement : ensuite, Keycloak l'ignore. Une fois un administrateur permanent créé et temp-admin supprimé, videz cette
# ligne (sans la retirer) : un mot de passe qui ne sert plus n'a rien à faire sur le serveur.
# Il se génère par :  openssl rand -hex 16
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=

# --- Les e-mails de Keycloak, par le relais SMTP de Brevo -------------------------------------------------------------
# Vérification de l'adresse, mot de passe oublié. Lus à l'import du royaume, au premier démarrage seulement : ensuite,
# ils se changent dans la console (Realm settings, Email).

# Le relais de Brevo, en STARTTLS sur le port 587.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
# L'identifiant et la clé SMTP de Brevo, dans « SMTP & API », onglet SMTP (une clé SMTP, pas une clé d'API).
SMTP_USER=
SMTP_PASSWORD=
# L'adresse de réponse, facultative : vide, on répond à no-reply@<domaine>.
SMTP_REPLY_TO=

# --- Le runner (étape 7.4) --------------------------------------------------------------------------------------------

# L'adresse du runner, sur son serveur, par le tunnel WireGuard.
RECALLIO_RUNNER_URL=http://10.13.13.2:8090
# Le jeton partagé avec le runner, le même dans son .env :  openssl rand -hex 32
RECALLIO_RUNNER_TOKEN=

# --- Les rappels par notification (Web Push, ADR 0047) ----------------------------------------------------------------
# Les clés VAPID, tirées une fois pour toutes : en changer invalide tous les abonnements. Une paire P-256, au format du
# backend (la clé publique brute de 65 octets, la privée de 32, en base64url), par openssl (docs/deploiement.md) :
#   openssl ecparam -name prime256v1 -genkey -noout -out vapid.pem
#   openssl ec -in vapid.pem -pubout -outform DER | tail -c 65 | openssl base64 -A | tr '+/' '-_' | tr -d '='
#   openssl ec -in vapid.pem -outform DER | head -c 39 | tail -c 32 | openssl base64 -A | tr '+/' '-_' | tr -d '='
#   shred -u vapid.pem
# La deuxième commande affiche la clé publique, la troisième la clé privée.
RECALLIO_PUSH_VAPID_PUBLIC_KEY=
RECALLIO_PUSH_VAPID_PRIVATE_KEY=
# Le contact du serveur pour les services de notification.
RECALLIO_PUSH_SUBJECT=mailto:admin@recallio.example

# --- Sentry, facultatif (ADR 0070) ------------------------------------------------------------------------------------
# Vides, rien n'est envoyé. Le DSN de chaque projet, et pour le front l'origine de son DSN
# (https://o<numéro>.ingest.de.sentry.io), admise par la Content-Security-Policy.
SENTRY_DSN_BACKEND=
SENTRY_DSN_FRONTEND=
SENTRY_ORIGIN_FRONTEND=
