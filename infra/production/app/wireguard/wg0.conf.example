# Le tunnel WireGuard vers le serveur du runner (ADR 0072), côté application : ce serveur appelle. Le backend joint le
# runner à son adresse dans le tunnel, http://10.13.13.2:8090 (RECALLIO_RUNNER_URL, dans le .env).
#
# Un modèle, sans aucune clé : à copier en /etc/wireguard/wg0.conf (chmod 600), puis à remplir en remplaçant chaque
# marqueur <...> (docs/deploiement.md, section 11, « WireGuard »). Les clés se génèrent sur chaque serveur ; une clé
# privée ne quitte jamais le sien.

[Interface]
# L'adresse du serveur dans le tunnel : le runner ne reçoit que les paquets qui en viennent.
Address = 10.13.13.1/24
# Pas de ListenPort : ce serveur n'attend rien, il appelle depuis un port choisi par le noyau.
# La clé privée de ce serveur : /etc/wireguard/private.key.
PrivateKey = <APP_PRIVATE_KEY>

[Peer]
# Le serveur du runner.
# Sa clé publique : /etc/wireguard/public.key, sur le serveur du runner.
PublicKey = <RUNNER_PUBLIC_KEY>
# La clé partagée par les deux serveurs (wg genpsk) : /etc/wireguard/preshared.key, la même des deux côtés.
PresharedKey = <PRESHARED_KEY>
# L'adresse IPv4 publique du serveur du runner, et le port où il écoute.
Endpoint = <RUNNER_PUBLIC_IP>:51820
# Seul le trafic vers le runner passe par le tunnel.
AllowedIPs = 10.13.13.2/32
# Un paquet toutes les 25 secondes : il garde ouverte l'entrée du pare-feu de ce serveur (ufw suit les connexions) par
# laquelle le runner répond, sans aucun port entrant à ouvrir ici.
PersistentKeepalive = 25
