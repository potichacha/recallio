<?xml version="1.0" encoding="UTF-8"?>
<!--
  Les bibliothèques que le bac à sable Java met sur le classpath des exercices et des programmes du Tour (ADR 0060) :
  Spring Boot, pour juger des exercices par @SpringBootTest, @WebMvcTest ou @DataJpaTest, et ce qu'apporte son starter de
  test (AssertJ, Mockito). Ce projet ne se construit pas : l'image n'en tire que les dépendances, copiées dans
  /opt/recallio/lib. Dependabot le tient à jour.

  JUnit n'y figure pas : le lanceur autonome de l'image l'apporte déjà, et deux copies se gêneraient.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.recallio.sandbox</groupId>
    <artifactId>java-libraries</artifactId>
    <version>1</version>
    <packaging>pom</packaging>

    <properties>
        <spring-boot.version>4.1.2</spring-boot.version>
        <maven-dependency-plugin.version>3.11.0</maven-dependency-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Une application web : contrôleurs, validation, et sa couche de persistance sur une base H2 en mémoire. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
        </dependency>

        <!-- Ses tests : @SpringBootTest, @WebMvcTest et MockMvc, @DataJpaTest, AssertJ, Mockito. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>${maven-dependency-plugin.version}</version>
            </plugin>
        </plugins>
    </build>
</project>
